<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kaixuan1">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import the tilted dual-arm robot model. -->
    <xacro:include filename="$(find tilt_kaixuan)/urdf/整体urdf.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="kaixuan1.ros2_control.xacro" />


    <xacro:kaixuan1_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
