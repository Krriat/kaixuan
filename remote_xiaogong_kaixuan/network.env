# 两台电脑必须使用相同的 Domain ID；当前机器人使用 26。
# 优先级：调用终端 ROS_DOMAIN_ID > KAIXUAN_ROS_DOMAIN_ID > 此处默认值。
KAIXUAN_ROS_DOMAIN_ID="${KAIXUAN_ROS_DOMAIN_ID:-26}"

# 正常局域网保持空字符串，使用 DDS 自动发现。
# 若 Wi-Fi 禁止组播，可在机器人上启动 Discovery Server，再在两端填写：
# KAIXUAN_DISCOVERY_SERVER="172.16.13.197:11811"
KAIXUAN_DISCOVERY_SERVER="${KAIXUAN_DISCOVERY_SERVER:-}"
